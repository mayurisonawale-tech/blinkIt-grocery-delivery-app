# MongoDB connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=

# Port the server listens on. Hosting platforms (Render, Railway) set this
# automatically — leave it blank there. Defaults to 3000 locally.
PORT=3000

# Allowed browser origins for CORS. Comma-separated, or * for any.
# In production set this to your deployed frontend URL, e.g.
# CORS_ORIGIN=https://blinkit-clone.netlify.app
CORS_ORIGIN=*
